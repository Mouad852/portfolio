# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
#
# .env.local is gitignored (see .gitignore) — it never reaches the repo.
# On Cloudflare / Vercel, set the same variables in the project's
# environment-variable settings instead of uploading a file.

# --- Contact form -----------------------------------------------------------
# Access key for the contact form. Get one free at https://web3forms.com.
#
# NEXT_PUBLIC_ is deliberate: Web3Forms' free tier only accepts submissions from
# the browser (a server-side POST returns 403 "Pro plan is required"), so the
# key ships in the client bundle. That is their design, not a leak — the key is
# a form identifier, not a credential. It cannot read past submissions or reach
# the account; the worst it allows is someone posting spam to the form, which
# their spam filtering and the honeypot field handle.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# --- Password-protected routes ----------------------------------------------
# Only used when a route is listed in `protectedRoutes` in
# src/resources/once-ui.config.ts. That list is currently empty, so this is
# inert — keep it set anyway so the auth route has something to compare against.
PAGE_ACCESS_PASSWORD=change-me
